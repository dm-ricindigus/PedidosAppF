rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function userIsDemo() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('isDemo', false) == true;
    }

    function isDemoAdmin() {
      return isAdmin() && userIsDemo();
    }

    function canAdminAccessOrder(orderData) {
      return isAdmin() && (
        !isDemoAdmin() ||
        (orderData.get('isDemo', false) == true &&
          orderData.adminId == request.auth.uid)
      );
    }

    function canAdminAccessOrderCode(codeData) {
      return isAdmin() && (
        !isDemoAdmin() ||
        (codeData.get('isDemo', false) == true &&
          codeData.adminId == request.auth.uid)
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Reglas para usuarios
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Reglas para códigos de pedido
    match /orderCodes/{codeId} {
      // Permite get cuando el doc no existe (para mostrar "código no existe")
      // sin permission-denied. Si existe, solo el cliente dueño o admin demo/prod.
      allow get: if isSignedIn() && (
        !exists(/databases/$(database)/documents/orderCodes/$(codeId)) ||
        resource.data.clientEmail == request.auth.token.email ||
        canAdminAccessOrderCode(resource.data)
      );

      allow list: if isSignedIn() && (
        resource.data.clientEmail == request.auth.token.email ||
        canAdminAccessOrderCode(resource.data)
      );

      // Solo Cloud Functions pueden crear códigos
      allow create: if false;

      // El cliente solo puede marcarlo como usado para su correo.
      allow update: if isSignedIn() &&
        resource.data.clientEmail == request.auth.token.email &&
        request.resource.data.clientEmail == resource.data.clientEmail &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['used', 'usedAt', 'usedBy']) &&
        request.resource.data.used == true &&
        request.resource.data.usedBy == request.auth.uid;

      // No permitir eliminar códigos
      allow delete: if false;
    }

    // Reglas para pedidos
    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.clientId == request.auth.uid ||
          canAdminAccessOrder(resource.data));

      allow create: if isSignedIn() &&
        request.resource.data.clientId == request.auth.uid;

      allow update: if isSignedIn() &&
        (resource.data.clientId == request.auth.uid ||
          canAdminAccessOrder(resource.data));

      allow delete: if canAdminAccessOrder(resource.data);
    }

    // Reglas para mensajes
    match /messages/{messageId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        (
          get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.clientId == request.auth.uid ||
          canAdminAccessOrder(
            get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data
          )
        );

      allow read: if isSignedIn() && (
        get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.clientId == request.auth.uid ||
        canAdminAccessOrder(
          get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data
        )
      );

      allow update: if isSignedIn() &&
        (resource.data.userId == request.auth.uid ||
          canAdminAccessOrder(
            get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data
          ));

      allow delete: if canAdminAccessOrder(
        get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data
      );
    }

    // Tokens FCM para notificaciones push (el cliente guarda su token)
    match /fcmTokens/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Config pública (versión mínima / actualización forzada), sin auth.
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Por defecto, denegar todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
